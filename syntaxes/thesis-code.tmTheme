<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Thesis Code</string>
  <!--
    Four colours and default ink, and nothing else.

    The theme used to carry twelve colours over seventeen scopes, one per
    syntactic role, and a twelve-line VMIR listing painted seven of them. The
    supervisor's annotation on the §4.2 excerpt was that there were too many to
    decode. Two of the twelve were also the same hue (#2f4f8f served both
    function names and SSA temporaries), so the scheme did not deliver the
    distinctions it charged the reader for.

    What survives is what a reader can name without a legend: a comment, a
    keyword, a type, a literal. Everything else is ink.

    The largest deletion is the per-namespace colouring of VMIR temporaries
    (`eN` a value, `hN` a heap, `pN` a permission amount). The prefix letter
    already names the namespace at every occurrence, so the hue restated the
    identifier rather than adding to it. Path conditions keep their italic,
    which is a weight rather than a colour and costs the palette nothing.
  -->
  <key>settings</key>
  <array>

    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#00000000</string>
        <key>foreground</key><string>#1c1c1c</string>
        <key>caret</key><string>#1c1c1c</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#7a7a7a</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Declaration heads keep the bold they had: a weight, not a hue, so it
         separates the head of a listing from its body for free. -->
    <dict>
      <key>name</key><string>Declaration keyword</string>
      <key>scope</key><string>keyword.declaration, storage.type.function, storage.type.struct, storage.type.enum, storage.type.class, keyword.other.fn</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#1a3fa0</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <!-- Every other keyword, in the one keyword colour: contract clauses,
         the heap and permission constructs, control flow, word operators. -->
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword.other.contract, keyword.control.heap, keyword.operator.wand, keyword.operator.arithmetic.vmir, keyword.control, keyword.other.section, keyword.operator.word, keyword.operator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#1a3fa0</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Types</string>
      <key>scope</key><string>storage.type, entity.name.type, support.type, storage.modifier, entity.name.tag.group</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#0f766e</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Constants and literals</string>
      <key>scope</key><string>constant.language, constant.numeric, constant.other, string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#b3541e</string>
      </dict>
    </dict>

    <!-- Italic, no colour: a path condition reads as an aside without
         spending a hue on it. -->
    <dict>
      <key>name</key><string>Path conditions and labels</string>
      <key>scope</key><string>entity.name.label, markup.italic.pathcond</string>
      <key>settings</key>
      <dict>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

  </array>
  <key>uuid</key>
  <string>7d1f0c1e-4a1b-4f22-9c3a-2f6b0a5e9d10</string>
</dict>
</plist>
